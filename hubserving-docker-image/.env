#######################
# 端口配置
#######################
# 宿主机基础端口配置（每个GPU实例会基于此端口递增）
BASE_PORT_SYSTEM=18842  # OCR系统服务基础端口
BASE_PORT_VIS=18843     # OCR可见光识别服务基础端口
BASE_PORT_MRZ=18844     # OCR证件码识别服务基础端口
BASE_PORT_GRAY=18845    # OCR灰度图识别服务基础端口

# Docker容器内部端口配置（固定端口）
CONTAINER_PORT_SYSTEM=12342  # OCR系统服务容器端口
CONTAINER_PORT_VIS=12343     # OCR可见光识别服务容器端口
CONTAINER_PORT_MRZ=12344     # OCR证件码识别服务容器端口
CONTAINER_PORT_GRAY=12345    # OCR灰度图识别服务容器端口

# 多GPU部署时的端口偏移量
PORT_OFFSET_PER_GPU=10       # 每个GPU实例的端口递增值

#######################
# Docker容器配置
#######################
CONTAINER_PREFIX=hubserving_  # Docker容器名称前缀
DOCKER_IMAGE=hubserving:v0.1  # Docker镜像名称和标签
DOCKER_SHM_SIZE=4g           # 共享内存大小
DOCKER_STACK_LIMIT=67108864  # 栈大小限制（64MB）
DOCKER_IPC=host              # IPC命名空间模式
DOCKER_MEMLOCK=-1            # 内存锁定限制（-1表示无限制）

#######################
# 节点配置
#######################
# 格式：IP:GPU数量，多个节点用逗号分隔
# 示例：192.168.3.23:1,192.168.1.15:1 表示两个节点各有1个GPU
NODES="192.168.3.23:1,192.168.1.15:1"

#######################
# Nginx配置
#######################
NGINX_CONTAINER_NAME=nginx-ocr          # Nginx容器名称
NGINX_IMAGE=nginx:latest                # Nginx镜像版本
NGINX_WORKER_CONNECTIONS=1024           # Nginx工作连接数

#######################
# API路径配置
#######################
# 各服务的API访问路径
API_PATH_SYSTEM=/predict/ocr_system      # OCR系统服务API路径
API_PATH_VIS=/predict/ocr_rec_vis        # OCR可见光识别服务API路径
API_PATH_MRZ=/predict/ocr_rec_mrz        # OCR证件码识别服务API路径
API_PATH_GRAY=/predict/ocr_rec_vis_gray  # OCR灰度图识别服务API路径