#######################
# 服务配置数组
#######################
# 格式：服务名称:基础端口:容器端口:API路径
SERVICES=(
    "system:18842:12342:/predict/ocr_system"
    "vis:18843:12343:/predict/ocr_rec_vis"
    "mrz:18844:12344:/predict/ocr_rec_mrz"
    "gray:18845:12345:/predict/ocr_rec_vis_gray"
    "ch_rec:18846:8867:/predict/ocr_rec"
)

# 多GPU部署时的端口偏移量
PORT_OFFSET_PER_GPU=10       # 每个GPU实例的端口递增值

#######################
# Docker容器配置
#######################
CONTAINER_PREFIX=hubserving_  # Docker容器名称前缀
DOCKER_IMAGE=hubserving:v0.1  # Docker镜像名称和标签
DOCKER_SHM_SIZE=4g           # 共享内存大小
DOCKER_IPC=host              # IPC命名空间模式

#######################
# 节点配置
#######################
# 格式：IP:GPU数量，多个节点用逗号分隔
# 示例：192.168.3.23:1,192.168.1.15:1 表示两个节点各有1个GPU
NODES="192.168.3.23:1,192.168.1.15:1"

#######################
# Nginx配置
#######################
NGINX_CONTAINER_NAME=nginx-ocr          # Nginx容器名称
NGINX_IMAGE=nginx:latest                # Nginx镜像版本
NGINX_WORKER_CONNECTIONS=1024           # Nginx工作连接数